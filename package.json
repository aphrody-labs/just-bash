{
  "name": "just-bash-monorepo",
  "private": true,
  "description": "Monorepo root for just-bash",
  "scripts": {
    "build": "bun --filter './packages/*' build",
    "build:worker": "bun --filter just-bash build:worker",
    "typecheck": "bun --filter just-bash build && bun --filter './packages/*' typecheck",
    "lint": "node scripts/check-workflow-security.mjs && biome check . && bun --filter './packages/*' lint:banned",
    "lint:fix": "biome check --write .",
    "knip": "bun --filter './packages/*' knip",
    "test:run": "bun --filter './packages/*' test:run",
    "test:unit": "bun --filter './packages/*' test:unit",
    "test:wasm": "bun --filter './packages/*' test:wasm",
    "test:comparison": "bun --filter './packages/*' test:comparison",
    "test:comparison:record": "bun --filter './packages/*' test:comparison:record",
    "test:dist": "bun --filter './packages/*' test:dist",
    "test:examples": "bun --filter cjs-consumer-example typecheck",
    "check:worker-sync": "bun --filter just-bash check:worker-sync",
    "check:deepsec-revalidation": "node scripts/check-deepsec-revalidation.mjs",
    "shell": "bun --filter just-bash shell",
    "dev:exec": "bun --filter just-bash dev:exec",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "bun --filter './packages/*' build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.1"
  },
  "packageManager": "bun@1.4.5",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "overrides": {
    "postcss@<8.5.10": "^8.5.10",
    "brace-expansion@<1.1.21": "1.1.21",
    "brace-expansion@>=5.0.0 <5.0.12": "5.0.12",
    "smol-toml@<1.9.0": "1.9.0",
    "undici@>=7.0.0 <7.29.1": "7.29.1",
    "undici@>=8.0.0 <8.10.2": "8.10.2"
  }
}
